# Cloudflare Tunnel token for foodshare-web-club tunnel
# Get this from: https://dash.cloudflare.com/?to=:/tunnels
# 
# Steps:
# 1. Go to Cloudflare Dashboard → Tunnels → foodshare-web-club
# 2. Click "Edit" → "Tokens" → "Add a new token"
# 3. Create a token with these permissions:
#    - Workers: Edit
#    - Routes: Read/Write
#    - Cloudflare DNS: Edit (if managing DNS through Cloudflare)
# 4. Copy the token value and paste it below
#
# IMPORTANT: Keep this token secret. Do not commit to version control.
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE

# Tunnel configuration
TUNNEL_NAME=foodshare-web-club
# Tunnel ping interval (seconds) — how often Cloudflare checks tunnel liveness
TUNNEL_PING_INTERVAL=30
# Tunnel metrics endpoint — disabled for minimal setup
# TUNNEL_METRICS=disabled